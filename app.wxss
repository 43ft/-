:root {
  --primary-color: #4A90D9;
  --success-color: #52c41a;
  --warning-color: #faad14;
  --danger-color: #f5222d;
  --bg-color: #1a1a2e;
  --card-bg: #16213e;
  --text-color: #ffffff;
  --text-secondary: #a0a0a0;
  --border-color: #2a2a4e;
}

page {
  background-color: var(--bg-color);
  color: var(--text-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  min-height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

.card {
  background-color: var(--card-bg);
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  transition: all 0.3s ease;
}

.btn-primary {
  background-color: var(--primary-color);
  color: white;
}

.btn-primary:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.btn-success {
  background-color: var(--success-color);
  color: white;
}

.btn-warning {
  background-color: var(--warning-color);
  color: #000;
}

.btn-danger {
  background-color: var(--danger-color);
  color: white;
}

.btn-disabled {
  background-color: #555;
  color: #888;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-around {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.flex-wrap {
  flex-wrap: wrap;
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: bold;
}

.text-primary {
  color: var(--primary-color);
}

.text-success {
  color: var(--success-color);
}

.text-warning {
  color: var(--warning-color);
}

.text-danger {
  color: var(--danger-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-large {
  font-size: 36rpx;
}

.text-xlarge {
  font-size: 48rpx;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mt-30 {
  margin-top: 30rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.mb-30 {
  margin-bottom: 30rpx;
}

.p-10 {
  padding: 10rpx;
}

.p-20 {
  padding: 20rpx;
}

.p-30 {
  padding: 30rpx;
}

.gap-10 {
  gap: 10rpx;
}

.gap-20 {
  gap: 20rpx;
}

.gap-30 {
  gap: 30rpx;
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background-color: #333;
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), #6db3f2);
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background-color: var(--primary-color);
  color: white;
}

.badge-success {
  background-color: var(--success-color);
}

.badge-warning {
  background-color: var(--warning-color);
  color: #000;
}

.badge-danger {
  background-color: var(--danger-color);
}

.icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background-color: rgba(255, 255, 255, 0.1);
}

.grid {
  display: grid;
}

.grid-2 {
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.grid-3 {
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.grid-4 {
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
}

.ore-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 15rpx;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
}

.ore-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.ore-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.ore-count {
  font-size: 26rpx;
  font-weight: bold;
  color: var(--text-color);
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-5rpx);
  }
  75% {
    transform: translateX(5rpx);
  }
}

.ani-fade-in {
  animation: fadeIn 0.3s ease;
}

.ani-pulse {
  animation: pulse 0.5s ease;
}

.ani-shake {
  animation: shake 0.3s ease;
}
