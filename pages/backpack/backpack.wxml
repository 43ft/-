<view class="container">
  <view class="card mb-20">
    <view class="flex-between">
      <view class="flex-col">
        <text class="text-secondary">💰 金币</text>
        <text class="text-large text-bold text-primary">{{playerData.gold}}</text>
      </view>
      <view class="flex-col text-right">
        <text class="text-secondary">背包 {{totalCount}}/{{playerData.backpack.capacity}}</text>
        <text class="text-secondary text-small">总价值: {{totalValue}} 金币</text>
      </view>
    </view>
  </view>

  <view class="flex-between mb-20">
    <text class="text-bold text-large">矿石背包</text>
    <button class="btn btn-warning" bindtap="onSellAll" disabled="{{totalValue <= 0}}">
      一键出售
    </button>
  </view>

  <view wx:if="{{oresList.length === 0}}" class="text-center text-secondary p-30">
    <text>背包空空如也\n快去挖矿吧！</text>
  </view>

  <view class="grid grid-3 gap-20">
    <view class="card text-center" wx:for="{{oresList}}" wx:key="oreId">
      <view class="ore-icon-large mb-10">{{item.icon}}</view>
      <text class="text-bold">{{item.name}}</text>
      <text class="badge badge-{{item.rarity}} mt-10">{{item.count}}</text>
      <view class="text-secondary text-small mt-10">
        <text>价值: {{item.value}}</text>
      </view>
      <button
        class="btn btn-primary btn-small mt-10"
        data-ore-id="{{item.oreId}}"
        bindtap="onSellOre"
      >
        出售
      </button>
    </view>
  </view>
</view>
