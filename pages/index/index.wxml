<view class="container">
  <view class="card">
    <view class="flex-between mb-20">
      <view class="flex-col text-center">
        <text class="text-secondary">💰 金币</text>
        <text class="text-large text-bold text-primary">{{playerData.gold}}</text>
      </view>
      <view class="flex-col text-center">
        <text class="text-secondary">📦 背包</text>
        <text class="text-large text-bold">{{backpackCount}}/{{playerData.backpack.capacity}}</text>
      </view>
      <view class="flex-col text-center">
        <text class="text-secondary">⛏️ 累计</text>
        <text class="text-large text-bold text-success">{{playerData.totalMined}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="flex-between mb-20">
      <view class="flex-col">
        <text class="text-bold text-large">{{eraName}}</text>
        <text class="text-secondary">第 {{playerData.currentLayer}} 层</text>
      </view>
      <view class="flex-col text-right">
        <text class="text-secondary">矿区规模</text>
        <text class="text-bold">{{mineField.size}}×{{mineField.size}}×{{mineField.size}}</text>
      </view>
    </view>

    <view class="progress-bar mb-10">
      <view class="progress-bar-inner" style="width: {{layerProgress}}%"></view>
    </view>
    <view class="flex-between text-secondary">
      <text>剩余: {{mineField.blocksRemaining}}</text>
      <text>进度: {{layerProgress}}%</text>
    </view>
  </view>

  <view class="card">
    <view class="text-center text-bold mb-20">矿区视图 (点击挖掘)</view>

    <view class="mine-grid" style="grid-template-columns: repeat({{mineField.size}}, 1fr);">
      <block wx:for="{{mineField.blocks}}" wx:for-item="layerBlocks" wx:for-index="y">
        <block wx:for="{{layerBlocks}}" wx:for-item="row" wx:for-index="z">
          <block wx:for="{{row}}" wx:for-item="block" wx:for-index="x">
            <view
              class="mine-block {{block.mined ? 'mined' : ''}}"
              data-x="{{block.x}}"
              data-y="{{block.y}}"
              data-z="{{block.z}}"
              bindtap="onMineBlock"
            >
              <text wx:if="{{!block.mined}}">{{ORES[block.oreId].icon}}</text>
              <text wx:else class="mined-text">·</text>
            </view>
          </block>
        </block>
      </block>
    </view>
  </view>

  <view class="card">
    <view class="text-center text-bold mb-20">当前产出</view>
    <view class="flex-wrap gap-10">
      <view class="ore-item-small" wx:for="{{currentLayerOres}}" wx:key="oreId">
        <text class="ore-icon-small">{{item.icon}}</text>
        <text class="ore-count-small">×{{item.count}}</text>
      </view>
      <text wx:if="{{currentLayerOres.length === 0}}" class="text-secondary">暂无产出</text>
    </view>
  </view>

  <view class="card">
    <view class="flex-between">
      <view class="flex-col">
        <text class="text-bold mb-10">⚡ 装备效果</text>
        <view class="text-secondary text-small">
          <text>挖掘速度: ×{{effects.mineSpeed}}</text>
        </view>
        <view class="text-secondary text-small">
          <text>自动采掘: {{effects.autoMineRate > 0 ? '已解锁' : '未解锁'}}</text>
        </view>
      </view>

      <button
        class="btn {{isAutoMining ? 'btn-warning' : 'btn-primary'}}"
        bindtap="toggleAutoMine"
        disabled="{{effects.autoMineRate === 0}}"
      >
        {{isAutoMining ? '⏸️ 停止' : '▶️ 自动'}}
      </button>
    </view>
  </view>
</view>
