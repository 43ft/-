.mine-grid {
  display: grid;
  gap: 4rpx;
  justify-content: center;
  margin: 0 auto;
}

.mine-block {
  width: 70rpx;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(74, 144, 217, 0.2);
  border-radius: 8rpx;
  font-size: 36rpx;
  transition: all 0.2s ease;
}

.mine-block:active:not(.mined) {
  transform: scale(0.9);
  background-color: rgba(74, 144, 217, 0.5);
}

.mine-block.mined {
  background-color: rgba(0, 0, 0, 0.2);
}

.mined-text {
  color: rgba(255, 255, 255, 0.2);
  font-size: 24rpx;
}

.ore-item-small {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 15rpx;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
}

.ore-icon-small {
  font-size: 32rpx;
}

.ore-count-small {
  font-size: 22rpx;
  color: var(--text-color);
  margin-top: 4rpx;
}

.text-small {
  font-size: 24rpx;
}

.backpack-count {
  font-size: 28rpx;
  color: var(--text-secondary);
}
