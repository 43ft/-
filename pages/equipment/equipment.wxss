.equipment-list {
  width: 100%;
}

.icon-circle {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  background-color: rgba(74, 144, 217, 0.2);
}

.cost-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  background-color: rgba(255, 255, 255, 0.1);
}

.cost-enough {
  background-color: rgba(82, 196, 26, 0.2);
  color: var(--success-color);
}

.cost-not {
  background-color: rgba(245, 34, 45, 0.2);
  color: var(--danger-color);
}

.text-left {
  text-align: left;
}

.text-small {
  font-size: 24rpx;
}
